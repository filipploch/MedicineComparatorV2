# Skopiuj do .env i uzupełnij (Flask wczytuje .env, jeśli zainstalowano python-dotenv)
FLASK_APP=wsgi.py
SECRET_KEY=zmien-na-dlugi-losowy-ciag
# DATABASE_URL=postgresql+psycopg://leki:haslo@localhost/leki
# Odstęp między zapytaniami do RPL w sekundach
RPL_DELAY_SECONDS=1.0
# Znaki, które mogą poprzedzać zeskanowany kod (GTIN / Data Matrix)
SCAN_PREFIXES=@
